# ============================================================
#  Credenciales (obligatorias) — en GitHub Actions van como SECRETS
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usa la SERVICE ROLE key (bypass RLS). Nunca la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Opcional: API key v3 o token de lectura v4 de TMDB (sin ella no se enriquecen movies/series)
TMDB_API_KEY=

# ============================================================
#  Ejecución
# ============================================================
# true → no escribe nada, sólo informa de lo que haría
DRY_RUN=true
# all | lista separada por comas: adult,size,dead,normalize,enrich,dedupe
STEPS=all
# debug | info | warn | error
LOG_LEVEL=info
# Si un paso falla, continuar con los siguientes
CONTINUE_ON_ERROR=true
# Nombre de la tabla y columna donde guardar el título limpio
TABLE_NAME=torrents
CLEAN_TITLE_COLUMN=title_text
# Tamaño de página (máx. 1000), tamaño de lote de borrado, concurrencia de UPDATE (fallback sin RPC)
PAGE_SIZE=1000
DELETE_CHUNK_SIZE=500
UPDATE_CONCURRENCY=8
# Filas por llamada a la RPC bulk_update_torrents (500 recorta los round-trips
# de la telemetría ids_* del enriquecedor sin arriesgar statement timeouts)
UPDATE_CHUNK_SIZE=500
# Salvaguarda: aborta el paso si quiere borrar más de este % de las filas evaluadas
# (no se aplica por debajo de 10 filas evaluadas: en tablas diminutas el % es ruido)
MAX_DELETE_RATIO=0.95

# ============================================================
#  1. Filtro adulto
# ============================================================
# Palabras extra (coma) que se suman a la lista integrada
ADULT_EXTRA_KEYWORDS=

# ============================================================
#  2. Anti-fakes por tamaño
# ============================================================
MIN_MOVIE_MB=150
MIN_SERIES_MB=30
SIZE_FILTER_APPLY_TO_ANIME=true
# Incluir size_bytes = 0 (tamaño desconocido) en el borrado
SIZE_FILTER_INCLUDE_ZERO=false

# ============================================================
#  3. Torrents muertos
# ============================================================
DEAD_AFTER_DAYS=30
DEAD_INCLUDE_NULL_SEEDERS=false

# ============================================================
#  4/5. Normalización
# ============================================================
# Sobrescribir `type` existente cuando el parser está seguro (>= NORMALIZE_TYPE_CONFIDENCE)
NORMALIZE_OVERWRITE_TYPE=false
NORMALIZE_TYPE_CONFIDENCE=0.8
# Sobrescribir season/episode/absolute_episode existentes
NORMALIZE_OVERWRITE_EPISODES=false
# Fusionar idiomas detectados en el título dentro de audio/subtitles
NORMALIZE_MERGE_TITLE_LANGUAGES=true

# ============================================================
#  6. Enriquecimiento
# ============================================================
ENRICH_MAX_LOOKUPS=300
ENRICH_MIN_SIMILARITY=0.6
ENRICH_TMDB_FOR_ANIME=true
ENRICH_CONCURRENCY=4

# --- Telemetría de resolución (necesita las columnas ids_*; ver sql/004) ------
# true  → usa ids_checked_at/ids_source/ids_confidence/ids_attempts si existen
# false → ignora esas columnas (se revisan todas las obras huérfanas cada vez)
ENRICH_TRACK_IDS_COLUMNS=true
# Días antes de volver a consultar una obra que no se pudo resolver
ENRICH_RECHECK_AFTER_DAYS=14
# Intentos máximos por obra antes de darla por perdida (0 = ilimitado)
ENRICH_MAX_ATTEMPTS=3

# --- Límites de tasa de las APIs -------------------------------------------
# AniList permite ~30 req/min pero responde 429 (con Retry-After) en cuanto te
# pasas; desde GitHub Actions las IPs de los runners van justas, así que se
# arranca en 20 y el cliente se auto-degrada si sigue rechazando.
ANILIST_RPM=20
# Tasa mínima a la que se degrada AniList tras varios 429 seguidos
ANILIST_MIN_RPM=5
KITSU_RPM=90
# Tasa mínima a la que se degrada Kitsu tras varios 429 seguidos
KITSU_MIN_RPM=15
TMDB_RPS=20

# ============================================================
#  7. Deduplicación
# ============================================================
# Torrents que no son ni spanish ni english: delete | keep
DEDUP_OTHER_LANGUAGE_POLICY=delete
# Torrents sin información de idioma: english | spanish | keep
DEDUP_UNKNOWN_LANGUAGE_AS=english
# Agrupar por título normalizado + año: incluye filas sin IDs y enlaza filas
# con/sin IDs si el título/año no es ambiguo (pon false para desactivarlo)
DEDUP_FALLBACK_TITLE_KEY=true
# Peso de los seeders (log2) en la puntuación
DEDUP_SEEDER_WEIGHT=20
